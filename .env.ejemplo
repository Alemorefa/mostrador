# Copiá este archivo como  .env  y completá los dos valores.
# Están en Supabase → Project Settings → API

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# La clave "anon" es pública a propósito: va dentro de la página y cualquiera
# puede verla. Lo que protege los datos no es esconderla, son las políticas de
# seguridad del esquema. La que NUNCA va acá es la "service_role".
